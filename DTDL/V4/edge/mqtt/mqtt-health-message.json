{
    "@context": [
        "dtmi:dtdl:context;4",
        "dtmi:dtdl:extension:annotation;2"
    ],
    "@id": "dtmi:io:tributech:healthmessage:mqtt;2",
    "@type": "Interface",
    "extends": [
        "dtmi:io:tributech:healthmessage:base;1"
    ],
    "displayName": "MQTT Source Health",
    "contents": [
        {
            "@type": [
                "Telemetry",
                "ValueAnnotation"
            ],
            "name": "Snapshot",
            "annotates": "HealthState",
            "displayName": "Snapshot",
            "description": "Point-in-time health readings taken at tick time.",
            "schema": {
                "@type": "Object",
                "fields": [
                    {
                        "name": "IsConnectedToIngressBroker",
                        "schema": "boolean",
                        "displayName": "Is Connected To Ingress Broker",
                        "description": "True if source is connected to ingress broker (or source broker itself if there is no additional ingress broker)."
                    },
                    {
                        "name": "FaultyStreams",
                        "schema": {
                            "@type": "Map",
                            "mapKey": {
                                "name": "streamId",
                                "schema": "string"
                            },
                            "mapValue": {
                                "name": "contextInfo",
                                "schema": "string"
                            }
                        },
                        "displayName": "Faulty Streams",
                        "description": "Key-value of faulty streams with its contextInfo (like the MQTT topic for Topic streams and jsonpath for jsonpath streams). Empty map when all OK."
                    }
                ]
            }
        },
        {
            "@type": [
                "Telemetry",
                "ValueAnnotation"
            ],
            "name": "Windowed",
            "annotates": "HealthState",
            "displayName": "Windowed",
            "description": "Windowed health observations accumulated since the last health tick.",
            "schema": {
                "@type": "Object",
                "fields": []
            }
        }
    ]
}
