{
    "@context": [
        "dtmi:dtdl:context;4",
        "dtmi:dtdl:extension:annotation;2"
    ],
    "@id": "dtmi:io:tributech:healthmessage:simulated;3",
    "@type": "Interface",
    "extends": [
        "dtmi:io:tributech:healthmessage:base;1"
    ],
    "displayName": "Simulated Source Health",
    "contents": [
        {
            "@type": [
                "Telemetry",
                "ValueAnnotation"
            ],
            "name": "Snapshot",
            "annotates": "HealthState",
            "displayName": "Snapshot",
            "description": "Point-in-time health readings taken at tick time.",
            "schema": {
                "@type": "Object",
                "fields": [
                    {
                        "name": "FaultyStreams",
                        "schema": {
                            "@type": "Map",
                            "mapKey": {
                                "name": "streamId",
                                "schema": "string"
                            },
                            "mapValue": {
                                "name": "configuredPeriod",
                                "schema": "duration"
                            }
                        },
                        "displayName": "Faulty Streams",
                        "description": "Key-Value of faulty streams currently not meeting schedule with its configured period."
                    }
                ]
            }
        },
        {
            "@type": [
                "Telemetry",
                "ValueAnnotation"
            ],
            "name": "Windowed",
            "annotates": "HealthState",
            "displayName": "Windowed",
            "description": "Windowed health observations accumulated since the last health tick.",
            "schema": {
                "@type": "Object",
                "fields": [
                    {
                        "name": "PerStreamFaultOccurrenceCount",
                        "schema": {
                            "@type": "Map",
                            "mapKey": {
                                "name": "streamId",
                                "schema": "string"
                            },
                            "mapValue": {
                                "name": "count",
                                "schema": "integer"
                            }
                        },
                        "displayName": "Per Stream Fault Occurrence Count",
                        "description": "Key-value of streams and the number of values since the last health tick that were generated later than the configured period plus the accepted fault tolerance. Every late value counts once, whether or not the stream is still faulty at tick time, so a stream that fell behind and caught up inside the reporting period is still visible here. Only streams with a non-zero count are listed. Empty map when none."
                    }
                ]
            }
        }
    ]
}
