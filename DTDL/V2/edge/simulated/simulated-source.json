{
    "@context": "dtmi:dtdl:context;4",
    "@id": "dtmi:io:tributech:source:simulated;2",
    "@type": "Interface",
    "extends": "dtmi:io:tributech:source:edge:base;2",
    "displayName": "Simulated Source",
    "contents": [
        {
            "@type": "Property",
            "name": "MaxBatchSize",
            "schema": "integer",
            "writable": true,
            "displayName": "Max batch size",
            "description": "The maximum number of values to send as batch in one message to the EdgeAgent (e.g. 1024)"
        },
        {
            "@type": "Property",
            "name": "FlushInterval",
            "schema": "integer",
            "writable": true,
            "displayName": "Flush interval",
            "description": "The interval (in seconds) in which the values should be flushed from the buffer and send to the Data-API. Regardless if the MaxBatchSize was reached. (e.g. 1)"
        },
        {
            "@type": "Relationship",
            "name": "Streams",
            "minMultiplicity": 0,
            "maxMultiplicity": 10,
            "target": "dtmi:io:tributech:stream:simulated",
            "displayName": "Streams",
            "description": "Contains all Simulated streams the given source."
        }, 
        {
            "@type": "Command",
            "name": "TriggerAnomalyCommand",
            "displayName": "Trigger Anomaly Command",
            "request": {
                "name": "TriggerAnomalyRequest",
                "displayName": "Trigger Anomaly Request",
                "description": "Request to trigger an anomaly.",
                "schema": {
                    "@type": "Object",
                    "fields": [
                        {
                            "name": "AnomalyFactor",
                            "schema": "double"
                        },
                        {
                            "name": "AnomalyType",
                            "schema": {
                                "@type": "Enum",
                                "valueSchema": "string",
                                "enumValues": [
                                {
                                    "name": "MultiplyMaxNumericValue",
                                    "displayName": "MultiplyMaxNumericValue",
                                    "enumValue": "MultiplyMaxNumericValue"
                                }
                                ]
                            }
                        }
                    ]
                }
            },
            "response": {
                "name": "TriggerAnomalyResponse",
                "displayName": "Trigger Anomaly Response",
                "description": "Response after triggering an anomaly.",
                "schema": {
                    "@type": "Object",
                    "fields": [
                        {
                            "name": "ExecutedAt",
                            "schema": "dateTime"
                        },
                        {
                            "name": "AdditionalInformation",
                            "schema": "string"
                        }, 
                        {
                            "name": "CommandState",
                            "schema": {
                                "@type": "Enum",
                                "valueSchema": "string",
                                "enumValues": [
                                {
                                    "name": "Rejected",
                                    "displayName": "Rejected",
                                    "enumValue": "Rejected"
                                }, 
                                {
                                    "name": "CouldNotBeSend",
                                    "displayName": "CouldNotBeSend",
                                    "enumValue": "CouldNotBeSend"
                                }, 
                                {
                                    "name": "Timeout",
                                    "displayName": "Timeout",
                                    "enumValue": "Timeout"
                                }, 
                                {
                                    "name": "CommandFailed",
                                    "displayName": "CommandFailed",
                                    "enumValue": "CommandFailed"
                                }, 
                                 {
                                    "name": "Error",
                                    "displayName": "Error",
                                    "enumValue": "Error"
                                }, 
                                {
                                    "name": "Success",
                                    "displayName": "Success",
                                    "enumValue": "Success"
                                }
                                ]
                            }
                        }, 
                        {
                            "name": "ExecutionDuration",
                            "schema": "dateTime"
                        }
                    ]
                }
            },
            "description": "The command to trigger an anomaly in the simulated data generation."
        }
    ]
}